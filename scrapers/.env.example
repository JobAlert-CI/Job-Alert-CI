SCRAPER_SEND_TO_API="1"
SCRAPER_API_BASE_URL="http://localhost:8000"
SCRAPER_API_TOKEN="change-me-scraper-token"

# Nombre de jours max depuis la publication (0=aujourd'hui, 1=aujourd'hui/hier, etc.)
# -1 = désactiver le filtre
SCRAPER_MAX_DAYS_OLD=1

# Vérifier la date d'expiration (1=oui, 0=non)
SCRAPER_CHECK_EXPIRATION=1

#===================================================
#  GoAfrica
#====================================================
SCRAPER_BASE_URL="https://www.tset.com/"
SCRAPER_SEARCH_QUERY="cote"

# Mode navigateur :
# 1 = headless / invisible
# 0 = navigateur visible
GO_HEADLESS=0

# Nombre maximum de pages de résultats à parcourir
GO_MAX_PAGES=7

# Nombre maximum de fiches de poste à scraper
# 0 = toutes les fiches
GO_MAX_JOBS=0

GO_OUTPUT_FILE="donnees_jobs_Go.json"  # Fichier de sortie principal
GO_FAILED_FILE="failed_jobs_Go.json"   # Fichier contenant les URLs / jobs en échec
GO_LOG_FILE="logsGo.log"            # Fichier de logs

# Niveau de logs affiché dans la console
# Valeurs possibles : TRACE, DEBUG, INFO, SUCCESS, WARNING, ERROR, CRITICAL
GO_LOG_LEVEL=INFO

GO_NAV_TIMEOUT_MS=45000
GO_ACTION_TIMEOUT_MS=8000

#====================================================
#  Educarriere
#====================================================
EDUC_BASE_URL="https://www.tset.com/"
EDUC_HEADLESS=0
EDUC_MAX_PAGES=7
EDUC_MAX_JOBS=0
EDUC_OUTPUT_FILE="donnees_jobs_Educ.json"
EDUC_FAILED_FILE="failed_jobs_Educ.json"
EDUC_LOG_FILE="logsEduc.log"
EDUC_LOG_LEVEL=INFO
EDUC_NAV_TIMEOUT_MS=45000
EDUC_ACTION_TIMEOUT_MS=8000
EDUC_COUNTRY_CODE="CI"

#====================================================
#  JobIvoire
#====================================================
JIV_BASE_URL="https://www.tset.com/"
JIV_HEADLESS=0
JIV_MAX_PAGES=2
JIV_MAX_JOBS=20
JIV_OUTPUT_FILE="donnees_jobs_jobivoire.json"
JIV_FAILED_FILE="failed_jobs_jobivoire.json"
JIV_LOG_FILE="logsJobIvoire.log"
JIV_LOG_LEVEL=INFO
JIV_NAV_TIMEOUT_MS=45000
JIV_ACTION_TIMEOUT_MS=8000

#====================================================
#  extract_offer.py (mode standalone)
#====================================================
# URL à parser (utilisée si aucun argument CLI n'est fourni)
SINGLE_OFFER_URL=""

# Fichier de sortie (vide = affichage console)
SINGLE_OFFER_OUTPUT_FILE=""

# Fichier de logs (vide = console uniquement)
SINGLE_OFFER_LOG_FILE=""

# Niveau de logs
SINGLE_OFFER_LOG_LEVEL=INFO

# Timeout HTTP en secondes
SINGLE_OFFER_TIMEOUT=30

# Code pays par défaut
PROJOB_COUNTRY_CODE="CI"