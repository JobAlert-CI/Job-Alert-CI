SCRAPER_SEND_TO_API="1"
SCRAPER_API_BASE_URL="http://localhost:8000"
SCRAPER_API_TOKEN="change-me-scraper-token"

#===================================================
#  GoAfrica
#====================================================
SCRAPER_BASE_URL="https://www.tset.com/"
SCRAPER_SEARCH_QUERY="cote"

# Mode navigateur :
# 1 = headless / invisible
# 0 = navigateur visible
SCRAPER_HEADLESS=0

# Nombre maximum de pages de résultats à parcourir
SCRAPER_MAX_PAGES=2

# Nombre maximum de fiches de poste à scraper
# 0 = toutes les fiches
SCRAPER_MAX_JOBS=20

SCRAPER_OUTPUT_FILE="donnees_jobs.json"  # Fichier de sortie principal
SCRAPER_FAILED_FILE="failed_jobs.json"   # Fichier contenant les URLs / jobs en échec
SCRAPER_LOG_FILE="logsGo.log"            # Fichier de logs

# Niveau de logs affiché dans la console
# Valeurs possibles : TRACE, DEBUG, INFO, SUCCESS, WARNING, ERROR, CRITICAL
SCRAPER_LOG_LEVEL=INFO

SCRAPER_NAV_TIMEOUT_MS=45000
SCRAPER_ACTION_TIMEOUT_MS=8000

