APP_NAME="JobAlert CI API"
APP_VERSION="1.0.0"
APP_ENV="development"
APP_TIMEZONE="Africa/Abidjan"

DATABASE_URL="postgresql+psycopg://jobalert_app:jobalert_password@localhost:5432/jobalert_ci"

DATABASE_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true

CORS_ORIGINS="http://localhost:5173,https://job-alert-ci.vercel.app"
AUTO_CREATE_TABLES=false

EMAIL_FROM="JobAlert CI <bonjour@jobalert.ci>"
DAILY_COLLECTION_HOUR=6
DAILY_DIGEST_HOUR=8

SCRAPER_API_TOKEN="change-me-scraper-token"
INGESTION_BATCH_SIZE_MAX=500
AI_ENABLED=false
REDIS_URL="redis://localhost:6379/2"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/1"
API_BASE_URL="http://localhost:8000"
SCRAPER_PYTHON=""
SCRAPER_SUBPROCESS_TIMEOUT_SECONDS=3600
ALLOW_DEMO_SCRAPER=false

# A definir en production pour proteger les routes /api/admin.
ADMIN_API_KEY=""

# OBLIGATOIRE en production: signe les JWT admin (access + refresh).
# Sans cette variable, l'app retombe sur un secret de dev non securise.
# Generer une valeur forte, ex: python -c "import secrets; print(secrets.token_urlsafe(64))"
ADMIN_JWT_SECRET=""
ADMIN_JWT_ACCESS_MINUTES=60
ADMIN_JWT_REFRESH_MINUTES=10080
